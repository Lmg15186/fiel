# Copy this file to .env and fill in the values from the Foundry project page.
# .env is listed in .gitignore and must never be committed.

# "Azure OpenAI endpoint" shown on the fiel project home page in Foundry.
# It ends with /openai/v1 — keep that part.
FOUNDRY_ENDPOINT=https://fiel-foundry.openai.azure.com/openai/v1

# "API key" shown on the same page.
FOUNDRY_API_KEY=paste-your-key-here

# Name of the deployment we created in Foundry.
FOUNDRY_DEPLOYMENT=gpt-5-mini
